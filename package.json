{
  "name": "webutils",
  "version": "1.0.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "watch": "tsc -p tsconfig.browser.json --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*",
    "drizzle-orm": "^0.45.4",
    "itty-router": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "itty-router": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/web": "^0.0.360",
    "drizzle-orm": "^0.45.4",
    "itty-router": "^5.0.0",
    "typescript": "^7.0.2"
  }
}
